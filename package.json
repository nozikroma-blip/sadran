{
  "name": "sadran",
  "productName": "Sadran",
  "version": "3.2.0",
  "description": "Sadran — проекты, задачи, дедлайны и исполнители",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "Hurma",
  "license": "MIT",
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hurma.sadran",
    "productName": "Sadran",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "!renderer/**/*.map",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nozikroma-blip",
        "repo": "sadran"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "electron-updater": "^6.8.9"
  }
}
